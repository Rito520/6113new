# SC6113 backend configuration template.
# Copy this file to `.env` for local runs; on Render, set these as service Environment
# Variables instead (never commit a real .env).
#
# ---- core ----
CHAIN_MODE=evm
PORT=3001
# Must exactly match the deployed frontend origin, or the browser blocks the API (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# ---- chain access ----
# Local demo:  http://127.0.0.1:8546   with CHAIN_ID=31337
# Sepolia:     your Alchemy/Infura URL with CHAIN_ID=11155111
RPC_URL=http://127.0.0.1:8546
CHAIN_ID=31337
# Local automine chains have no reorgs, so 0 avoids spurious 409 INSUFFICIENT_CONFIRMATIONS.
# Use 2 or more on a public testnet.
CHAIN_CONFIRMATIONS=0

# ---- contract addresses (fill from contracts/deployments/<network>.json) ----
ROLE_MANAGER_ADDRESS=
PROJECT_ESCROW_ADDRESS=
DISPUTE_MANAGER_ADDRESS=

# ---- SQLite location ----
# Local default is ./data/sc6113.db. Render's filesystem is ephemeral, so point it at /tmp.
# DATABASE_PATH=/tmp/sc6113.db

# ---- session lifetimes (optional) ----
# AUTH_NONCE_TTL_SECONDS=300
# AUTH_SESSION_TTL_SECONDS=28800

# ---- local demo seeding only (ignored on Sepolia; see scripts/grant-arbitrator.js) ----
# DEMO_CLIENT_ADDRESS=
# DEMO_FREELANCER_ADDRESS=
# DEMO_ARBITRATOR_ADDRESS=
