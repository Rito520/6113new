# SC6113 frontend configuration template (Vite).
# Copy to `.env` for local runs; on Render set these as Static Site Environment Variables.
# Vite only exposes variables prefixed with VITE_, and they are inlined at BUILD time,
# so changing them requires a redeploy.
#
# ---- backend API ----
# Local:  http://localhost:3001
# Render: the Web Service URL, e.g. https://sc6113-backend.onrender.com
VITE_API_BASE_URL=http://localhost:3001

# ---- chain ----
# Local demo: 0x7a69  (31337)
# Sepolia:    0xaa36a7 (11155111)
VITE_CHAIN_ID=0x7a69
# Only used as a fallback hint; the browser talks to the chain through MetaMask.
VITE_RPC_URL=http://127.0.0.1:8546

# ---- contract addresses (from contracts/deployments/<network>.json) ----
# Leave empty to fall back to the committed src/contracts/localhost.json values.
VITE_ROLE_MANAGER_ADDRESS=
VITE_PROJECT_ESCROW_ADDRESS=
VITE_DISPUTE_MANAGER_ADDRESS=
